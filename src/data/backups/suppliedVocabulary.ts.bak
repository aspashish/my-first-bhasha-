  { word: 'Anyone', phoneticHindi: 'एनीवन', hindiMeaning: 'कोई भी' },
  { word: 'Double', phoneticHindi: 'डबल', hindiMeaning: 'दोगुना' },
  { word: 'Triple', phoneticHindi: 'ट्रिपल', hindiMeaning: 'तिगुना' },
  { word: 'Outside', phoneticHindi: 'आउटसाइड', hindiMeaning: 'बाहर' },
  { word: 'Near', phoneticHindi: 'नियर', hindiMeaning: 'पास' },
  { word: 'Far', phoneticHindi: 'फार', hindiMeaning: 'दूर' },
];

/**
 * Builds the initial vocabulary dataset with stable IDs and default category 'to_learn'.
 */
export function getInitialSuppliedVocabulary(): VocabularyWord[] {
  return RAW_SUPPLIED_VOCABULARY.map((item, idx) => {
    const cleanWord = item.word.trim();
    const slug = cleanWord.toLowerCase().replace(/[^a-z0-9]/g, '-');
    const stableId = `vocab-supplied-${idx + 1}-${slug}`;
    const enrichedFallback = createEnrichedWordFallback(cleanWord, idx + 1);

    return {
      ...enrichedFallback,
      id: stableId,
      index: idx + 1,
      word: cleanWord,
      phoneticHindi: item.phoneticHindi,
      hindiMeaning: item.hindiMeaning,
      category: 'to_learn' as VocabCategory,
      status: WordMasteryStatus.NEW,
      pronunciationTipHindi: `उच्चारण: "${item.phoneticHindi}"। साफ़ आवाज़ में बोलें।`,
      usageExplanationHindi: `हिंदी अर्थ: "${item.hindiMeaning}"। दैनिक बातचीत में इसका प्रयोग करें।`,
    };
  });
}
