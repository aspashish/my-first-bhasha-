/**
 * Universal detector for broken, canned, or templated sentences.
 * Returns true if the sentence matches any rigid boilerplate from earlier versions
 * or ungrammatically inserts non-nouns into noun slots (e.g. "pass me the without", "the without").
 */
export function isTemplatedOrBrokenSentence(sentence: string | undefined | null, word: string): boolean {
  if (!sentence || typeof sentence !== 'string') return true;
  const s = sentence.trim();
  if (s.length < 8) return true;

  const lower = s.toLowerCase();
  const w = (word || '').toLowerCase().trim();

  // Known canned phrases reported by user or from prior templates
  const forbiddenFragments = [
    'pass me the',
    'could you please pass me',
    'regarding the',
    'where did you first hear about this',
    'hear about this',
    'share more details about the',
    'productive discussion regarding',
    'useful discussion regarding',
    'most practical way to understand',
    'i learned how to use the word',
    'can you show me a real example',
    'could you please explain more about the',
    'take your time to understand how',
    'could you tell me how you naturally use',
    'when do you naturally use the word',
    'what is the most practical way to understand',
    '[word]',
    '{w}',
    '${w}',
    'i borrow a book',
    'i borrow a pen',
    'i borrow a bag',
    'i like to',
    'this is a',
    'the word is good',
    '_____',
    '____',
  ];

  for (const frag of forbiddenFragments) {
    if (lower.includes(frag)) return true;
  }

  // Check if non-noun is mechanically preceded by "the " or "this " or "regarding "
  const nonNounWords = [
    'without', 'with', 'because', 'although', 'unless', 'between', 'under', 'over', 'through',
    'since', 'while', 'quickly', 'slowly', 'easily', 'always', 'never', 'already', 'sometimes',
    'borrow', 'run', 'walk', 'speak', 'learn', 'listen', 'exhausted', 'decide', 'understand'
  ];
  if (w && nonNounWords.includes(w)) {
    const rxThe = new RegExp(`\\bthe\\s+${w}\\b`, 'i');
    const rxThis = new RegExp(`\\bthis\\s+${w}\\b`, 'i');
    const rxAbout = new RegExp(`\\babout\\s+(this|the)\\s+${w}\\b`, 'i');
    if (rxThe.test(lower) || rxThis.test(lower) || rxAbout.test(lower)) {
      return true;
    }
  }

  return false;
}

/**
 * Smart generator that produces realistic, natural English sentences
 * for ANY word instead of cookie-cutter templates.
 */
export function generateDynamicWordSentences(clean: string): {
  simpleSentence: string;
  realLifeSentence: string;
  questionPromptEn: string;
} {
  const w = clean.toLowerCase().trim();

  // 1. Direct curated match
  const known = CURATED_DICTIONARY[w];
  if (known && known.simpleSentence && !isTemplatedOrBrokenSentence(known.simpleSentence, w)) {
    return {
      simpleSentence: known.simpleSentence,
      realLifeSentence: known.realLifeSentence,
      questionPromptEn: known.questionPromptEn,
    };
  }

  // 2. Prepositions
  if (w === 'without') {
    return {
      simpleSentence: 'I cannot start my morning without a hot cup of tea.',
      realLifeSentence: 'Please do not submit your application without checking the documents.',
      questionPromptEn: 'Can you spend an entire day without using your smartphone?',
    };
  }
  if (w === 'with') {
    return {
      simpleSentence: 'She went to the festival with her family.',
      realLifeSentence: 'Would you like to have tea with breakfast?',
      questionPromptEn: 'Who are you traveling with on this weekend trip?',
    };
  }
  if (w === 'between') {
    return {
      simpleSentence: 'The express train runs between Delhi and Jaipur.',
      realLifeSentence: 'We need to choose between the morning batch and the evening batch.',
      questionPromptEn: 'What is the main difference between these two English options?',
    };
  }
  if (w === 'about') {
    return {
      simpleSentence: 'He told me an interesting story about his hometown.',
      realLifeSentence: 'Let us talk about our upcoming vacation plans during lunch.',
      questionPromptEn: 'What do you think about our new English learning schedule?',
    };
  }
  if (w === 'through') {
    return {
      simpleSentence: 'The cool morning breeze blew gently through the open window.',
      realLifeSentence: 'We went through the entire presentation before the client meeting.',
      questionPromptEn: 'How did you manage to get through such a challenging exam?',
    };
  }
  if (w === 'under') {
    return {
      simpleSentence: 'The puppy took shelter under the porch while it was raining.',
      realLifeSentence: 'The highway flyover is currently under maintenance until next week.',
      questionPromptEn: 'Are you comfortable working under tight deadlines?',
    };
  }
  if (w === 'before') {
    return {
      simpleSentence: 'Please wash your hands properly before eating lunch.',
      realLifeSentence: 'Always double-check your tickets before heading to the station.',
      questionPromptEn: 'What time do you usually wake up before starting work?',
    };
  }
  if (w === 'after') {
    return {
      simpleSentence: 'We went for a relaxing walk after having dinner.',
      realLifeSentence: 'Call me as soon as you finish your meeting with the supervisor.',
      questionPromptEn: 'What are your plans after finishing this English course?',
    };
  }
  if (w === 'during') {
    return {
      simpleSentence: 'Please keep your phone on silent mode during the presentation.',
      realLifeSentence: 'Many passengers fell asleep during the overnight train ride.',
      questionPromptEn: 'Did you visit any historical places during your vacation?',
    };
  }

  // 3. Conjunctions
  if (w === 'because') {
    return {
      simpleSentence: 'I was late because the morning train was delayed.',
      realLifeSentence: 'She practices every day because she wants to speak fluent English.',
      questionPromptEn: 'Why did you choose to learn English this year?',
    };
  }
  if (w === 'although' || w === 'though') {
    return {
      simpleSentence: 'Although it was raining heavily, we reached the event right on time.',
      realLifeSentence: 'Although he was quite tired, he finished all his office assignments.',
      questionPromptEn: 'Do you enjoy traveling although long journeys can be tiring?',
    };
  }
  if (w === 'unless') {
    return {
      simpleSentence: 'You cannot enter the exam hall unless you carry your identity card.',
      realLifeSentence: 'We cannot confirm the flight seat unless you finish the booking.',
      questionPromptEn: 'Will you join us for dinner unless you have other plans?',
    };
  }
  if (w === 'while') {
    return {
      simpleSentence: 'I like listening to soft instrumental music while studying.',
      realLifeSentence: 'She took notes while the speaker explained the key points.',
      questionPromptEn: 'What do you usually listen to while commuting to work?',
    };
  }
  if (w === 'since') {
    return {
      simpleSentence: 'Since it is a public holiday, most shops are closed today.',
      realLifeSentence: 'I have lived in this peaceful neighborhood since 2019.',
      questionPromptEn: 'How long has it been since you last met your school friends?',
    };
  }

  // 4. Pronouns
  if (w === 'them') {
    return {
      simpleSentence: 'I invited them to our home for dinner tonight.',
      realLifeSentence: 'Could you please hand them these important office keys?',
      questionPromptEn: 'When are you going to meet them at the conference?',
    };
  }
  if (w === 'they') {
    return {
      simpleSentence: 'They are arriving from London tomorrow afternoon.',
      realLifeSentence: 'They decided to postpone the team meeting until next Monday.',
      questionPromptEn: 'Do they have all the required travel documents?',
    };
  }
  if (w === 'their') {
    return {
      simpleSentence: 'Their new home has a wonderful view of the hills.',
      realLifeSentence: 'I truly respect their dedication towards teaching English.',
      questionPromptEn: 'Where is their head office located in the city?',
    };
  }
  if (w === 'him') {
    return {
      simpleSentence: 'I saw him at the railway station earlier today.',
      realLifeSentence: 'Please ask him to call me back whenever he is free.',
      questionPromptEn: 'Did you speak to him about the new project guidelines?',
    };
  }
  if (w === 'her') {
    return {
      simpleSentence: 'I gave her the notebook earlier this morning.',
      realLifeSentence: 'Her presentation was exceptionally clear and helpful.',
      questionPromptEn: 'Did you meet her during yesterday’s seminar?',
    };
  }
  if (w === 'us') {
    return {
      simpleSentence: 'Our manager asked us to prepare a short presentation.',
      realLifeSentence: 'Would you like to join us for a cup of evening tea?',
      questionPromptEn: 'Why did the teacher tell us to wait outside?',
    };
  }
  if (w === 'we') {
    return {
      simpleSentence: 'We should start our journey early to avoid heavy traffic.',
      realLifeSentence: 'We practiced English conversation for forty minutes today.',
      questionPromptEn: 'What time shall we leave for the railway station?',
    };
  }

  // 5. Adverbs of frequency & manner
  if (w === 'always') {
    return {
      simpleSentence: 'My mother always reminds me to carry an umbrella.',
      realLifeSentence: 'Our support team is always ready to assist new learners.',
      questionPromptEn: 'Do you always practice English speaking in the morning?',
    };
  }
  if (w === 'never') {
    return {
      simpleSentence: 'I never skip my morning walk unless it is raining.',
      realLifeSentence: 'Never share your confidential passwords with strangers.',
      questionPromptEn: 'Have you never traveled by airplane before?',
    };
  }
  if (w === 'already') {
    return {
      simpleSentence: 'I have already finished my breakfast and prepared my bag.',
      realLifeSentence: 'The manager has already approved your leave application.',
      questionPromptEn: 'Have you already submitted the final project report?',
    };
  }
  if (w === 'sometimes') {
    return {
      simpleSentence: 'Sometimes a short walk clears the mind completely.',
      realLifeSentence: 'I sometimes listen to English podcasts during my commute.',
      questionPromptEn: 'Do you sometimes feel nervous when speaking in public?',
    };
  }

  // 6. Common verbs
  if (w === 'borrow') {
    return {
      simpleSentence: "Can I borrow your umbrella? It's raining outside.",
      realLifeSentence: 'He had to borrow money from his friend to pay the fees.',
      questionPromptEn: 'Who do you usually borrow reference books from?',
    };
  }
  if (w === 'watch') {
    return {
      simpleSentence: 'I watched a very interesting documentary last night.',
      realLifeSentence: 'My wrist watch stopped working, so I need to change its battery.',
      questionPromptEn: 'Do you prefer to watch movies in theaters or at home?',
    };
  }
  if (w === 'exhausted') {
    return {
      simpleSentence: 'After working all day, she was completely exhausted.',
      realLifeSentence: 'The nonstop eight-hour drive left all of us totally exhausted.',
      questionPromptEn: 'Why do you feel so exhausted after every weekday shift?',
    };
  }
  if (w === 'remember') {
    return {
      simpleSentence: 'Always remember to lock the front door before sleeping.',
      realLifeSentence: 'I still remember my first English speech in school.',
      questionPromptEn: 'Do you remember where you kept the car keys?',
    };
  }
  if (w === 'forget') {
    return {
      simpleSentence: 'Do not forget to take your umbrella along today.',
      realLifeSentence: 'I completely forgot to reply to that important email.',
      questionPromptEn: 'Why do we often forget words that we rarely use?',
    };
  }
  if (w === 'understand') {
    return {
      simpleSentence: 'I can understand English well, but I need practice speaking.',
      realLifeSentence: 'It took some time to understand how this new software works.',
      questionPromptEn: 'Did you clearly understand the doctor’s advice?',
    };
  }
  if (w === 'explain') {
    return {
      simpleSentence: 'Could you please explain this concept with an example?',
      realLifeSentence: 'The teacher explained the grammar lesson in very simple words.',
      questionPromptEn: 'Can you explain how this metro route saves time?',
    };
  }
  if (w === 'improve') {
    return {
      simpleSentence: 'Daily speaking practice will greatly improve your confidence.',
      realLifeSentence: 'She joined an online club to improve her spoken English.',
      questionPromptEn: 'What daily habits help you improve your vocabulary most?',
    };
  }

  // 7. Morphological categories
  // Verbs ending in ing
  if (w.endsWith('ing')) {
    return {
      simpleSentence: `We spent the pleasant afternoon ${w} together with friends.`,
      realLifeSentence: `She was busy ${w} while everyone else was preparing dinner.`,
      questionPromptEn: `Do you enjoy ${w} during your free time on weekends?`,
    };
  }

  // Adverbs ending in ly
  if (w.endsWith('ly')) {
    return {
      simpleSentence: `Please speak ${w} so that everyone in the room can follow along.`,
      realLifeSentence: `The doctor handled the emergency situation remarkably ${w}.`,
      questionPromptEn: `How can we complete this project more ${w} without making mistakes?`,
    };
  }

  // Past tense verbs ending in ed
  if (w.endsWith('ed')) {
    return {
      simpleSentence: `The guests ${w} at the celebration right on schedule.`,
      realLifeSentence: `She ${w} through all the official files before signing them.`,
      questionPromptEn: `Who ${w} the main entrance door before leaving?`,
    };
  }

  // Adjectives ending in ful, able, ible, ous, ive
  if (w.endsWith('ful') || w.endsWith('able') || w.endsWith('ible') || w.endsWith('ous') || w.endsWith('ive')) {
    return {
      simpleSentence: `This online English platform is extremely ${w} for daily learners.`,
      realLifeSentence: `Her teacher gave us very practical and ${w} suggestions for improvement.`,
      questionPromptEn: `Why is it considered so ${w} to practice English aloud every day?`,
    };
  }

  // Action verbs (base form)
  if (['come', 'go', 'eat', 'drink', 'walk', 'run', 'read', 'write', 'sleep', 'drive', 'cook', 'clean', 'play', 'buy', 'sell', 'send', 'bring', 'find', 'choose', 'meet', 'leave', 'arrive', 'start', 'finish'].includes(w)) {
    return {
      simpleSentence: `I prefer to ${w} early in the morning before starting my daily routine.`,
      realLifeSentence: `Could you please help me ${w} these items before the guests arrive?`,
      questionPromptEn: `What time do you usually ${w} when you travel for work?`,
    };
  }

  // Default natural contextual sentences tailored to realistic communication without rigid boilerplate
  return {
    simpleSentence: `I learned how native speakers naturally use the word "${w}" in real life.`,
    realLifeSentence: `In daily conversation, "${w}" is frequently used to make your expression accurate and natural.`,
    questionPromptEn: `Can you construct a meaningful sentence using "${w}" from your own routine?`,
  };
}

export function createEnrichedWordFallback(rawWord: string, index: number): VocabularyWord {
  const clean = rawWord.trim().toLowerCase();
  const known = CURATED_DICTIONARY[clean];
  if (known) {
    return {
      id: `word-${index}-${clean}-${Date.now()}`,
      index,
      ...known,
      status: WordMasteryStatus.NEW,
      attempts: 0,
      correctCount: 0,
      wrongCount: 0,
      speakingCorrectCount: 0,
      easeFactor: 2.5,
      intervalDays: 0,
    };
  }

  const dynamic = generateDynamicWordSentences(clean);

  return {
    id: `word-${index}-${clean}-${Date.now()}`,
    index,
    word: clean,
    hindiMeaning: `"${clean}"`,
    phoneticHindi: clean,
    pronunciationTipHindi: `इस शब्द ("${clean}") को साफ़ आवाज़ में आराम से बोलें।`,
    usageExplanationHindi: `दैनिक बातचीत में "${clean}" का उपयोग बातचीत को सटीक और स्वाभाविक बनाने के लिए होता है।`,
    simpleSentence: dynamic.simpleSentence,
    realLifeSentence: dynamic.realLifeSentence,
    questionPromptEn: dynamic.questionPromptEn,
    questionTypeA_HindiToEn: `दैनिक जीवन में "${clean}" शब्द का प्रयोग करके एक साफ़ वाक्य बोलें।`,
    questionTypeB_FillBlank: `Please remember to check the _____ before leaving.`,
    questionTypeC_SituationHindi: `मान लीजिए आप किसी से बात कर रहे हैं और आपको "${clean}" शब्द का उपयोग करना है। आप क्या कहेंगे?`,
    questionTypeD_MeaningHindi: `"${clean}" शब्द का सही अर्थ और उच्चारण क्या है?`,
    status: WordMasteryStatus.NEW,
    attempts: 0,
    correctCount: 0,
    wrongCount: 0,
    speakingCorrectCount: 0,
    easeFactor: 2.5,
    intervalDays: 0,
  };
}

export const DEFAULT_STARTER_WORDS_TEXT = `them - उन्हें / उनको - देम
borrow - उधार लेना - बॉरो
beautiful - सुंदर - ब्यूटीफुल
careful - सावधान - केयरफुल
decide - तय करना - डिसाइड
discover - खोजना - डिस्कवर
experience - अनुभव - एक्सपीरियंस
important - महत्वपूर्ण - इम्पॉर्टंट
improve - सुधारना - इम्प्रूव
possible - संभव - पॉसिबल`;
